# Development Environment Configuration
# This file is used when running `npm run dev` 

# Development database (local PostgreSQL instance)
# Connect to local PostgreSQL database
DATABASE_URL="postgresql://postgres:12345@localhost:5432/FitFlix"

# Direct connection to the database. Used for migrations
DIRECT_URL="postgresql://postgres:12345@localhost:5432/FitFlix"


# Development server configuration
NODE_ENV=development
PORT=3000
DEBUG_LOGS=true

# Development authentication
JWT_SECRET="dev-jwt-secret-key-for-local-testing-only"
JWT_EXPIRES_IN=7d
COOKIE_SECRET="dev-cookie-secret-for-local-testing-only"

# Development CORS - Allow all localhost ports for easy development
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:5173,http://localhost:8080

# Development frontend URLs
ADMIN_DASHBOARD_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173  
WEBSITE_URL=http://localhost:8080

# Relaxed rate limiting for development
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=60000

# Development metrics (optional)
ENABLE_METRICS=false
METRICS_PORT=9090

# Development Google Sheets webhooks (use test webhooks or disable)
GSHEET_WEBHOOK_DEFAULT=http://localhost:3000/api/test/webhook
GSHEET_WEBHOOK_EC=http://localhost:3000/api/test/webhook  
GSHEET_WEBHOOK_MARATHAHALLI=http://localhost:3000/api/test/webhook
GSHEET_WEBHOOK_BROOKEFIELD=http://localhost:3000/api/test/webhook
GSHEET_WEBHOOK_CORPORATE=http://localhost:3000/api/test/webhook
GSHEET_WEBHOOK_ITI_LAYOUT=http://localhost:3000/api/test/webhook